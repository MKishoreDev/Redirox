# ==============================================================================
# Redirox Environment Configuration Example
# Copy this file to .env and replace with your credentials
# ==============================================================================

# MongoDB Connection String (MongoDB Atlas or Local instance)
# Local default: mongodb://localhost:27017/redirox
# Atlas format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/redirox?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/redirox

# Flask Port (Optional, defaults to 5000)
PORT=5000

# Flask Environment (Optional, 'development' or 'production')
FLASK_ENV=development
